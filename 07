#include <iostream>
#include <string>
using namespace std;

// Prototipos
void inicializarNombres(string letras[]);
string convertirALetras(int numero, string letras[]);

int main() {
    string letras[21];
    inicializarNombres(letras);

    int numero;
    cout << "Ingrese un numero entero entre 0 y 20: ";
    cin >> numero;

    if (numero >= 0 && numero <= 20) {
        cout << numero << " -> " << convertirALetras(numero, letras) << endl;
    } else {
        cout << "Numero fuera de rango." << endl;
    }
    return 0;
}

