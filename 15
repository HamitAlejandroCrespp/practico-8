#include <iostream>
#include <string>
using namespace std;

// Prototipos
void leerAlumnos(string nombres[], float notas[], int n);
void mostrarAlumnos(string nombres[], float notas[], int n);
void ordenarPorNotaDesc(string nombres[], float notas[], int n);

int main() {
    int n;
    string nombres[100];
    float notas[100];

    cout << "Ingrese la cantidad de estudiantes (n >= 3): ";
    cin >> n;

    if (n >= 3 && n <= 100) {
        leerAlumnos(nombres, notas, n);

        ordenarPorNotaDesc(nombres, notas, n);

        cout << "\n--- TRES MEJORES NOTAS ---" << endl;
        for (int i = 0; i < 3; i++) {
            cout << i + 1 << ". " << nombres[i] << " - Nota: " << notas[i] << endl;
        }
    } else {
        cout << "Cantidad invalida (n debe ser al menos 3)." << endl;
    }
    return 0;
}

void leerAlumnos(string nombres[], float notas[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Nombre del estudiante " << i + 1 << ": ";
        cin >> nombres[i];

        do {
            cout << "Nota (0 a 100): ";
            cin >> notas[i];
            if (notas[i] < 0 || notas[i] > 100) {
                cout << "Nota invalida. Intente de nuevo." << endl;
            }
        } while (notas[i] < 0 || notas[i] > 100);
    }
}

void ordenarPorNotaDesc(string nombres[], float notas[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (notas[j] < notas[j + 1]) {
                // Intercambiar notas
                float auxNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = auxNota;

                // Intercambiar nombres en paralelo
                string auxNombre = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = auxNombre;
            }
        }
    }
}
