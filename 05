#include <iostream>
using namespace std;

// Prototipos
void leer(int v[], int n);
void mostrar(int v[], int n);
bool esCapicua(int v[], int n);

int main() {
    int n;
    int v[100];
    
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;
    
    if (n > 0 && n <= 100) {
        leer(v, n);
        mostrar(v, n);
        
        if (esCapicua(v, n)) {
            cout << "El vector ES capicua." << endl;
        } else {
            cout << "El vector NO es capicua." << endl;
        }
    } else {
        cout << "Cantidad invalida." << endl;
    }
    return 0;
}

// Implementaciones
void leer(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Valor " << i + 1 << ": ";
        cin >> v[i];
    }
}

void mostrar(int v[], int n) {
    cout << "Vector: ";
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

bool esCapicua(int v[], int n) {
    int inicio = 0;
    int fin = n - 1;
    
    while (inicio < fin) {
        if (v[inicio] != v[fin]) {
            return false; // Si hay uno distinto, ya no es capicúa
        }
        inicio++;
        fin--;
    }
    return true; // Si terminó de revisar todo y son iguales
}
