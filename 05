#include <iostream>
using namespace std;

// Prototipos
void leer(int v[], int n);
void mostrar(int v[], int n);
bool esCapicua(int v[], int n);

int main() {
    int n;
    int v[100];

    cout << "Ingrese la cantidad de elementos (n > 0): ";
    cin >> n;

    if (n > 0 && n <= 100) {
        leer(v, n);
        mostrar(v, n);

        if (esCapicua(v, n)) {
            cout << "El vector ES capicua." << endl;
        } else {
            cout << "El vector NO es capicua." << endl;
        }
    } else {
        cout << "Cantidad invalida." << endl;
    }
    return 0;
}

void leer(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Ingrese el valor " << i + 1 << ": ";
        cin >> v[i];
    }
}

void mostrar(int v[], int n) {
    cout << "Vector: [ ";
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << "]" << endl;
}

bool esCapicua(int v[], int n) {
    int i = 0;
    int j = n - 1;
    while (i < j) {
        if (v[i] != v[j]) {
            return false;
        }
        i++;
        j--;
    }
    return true;
}
