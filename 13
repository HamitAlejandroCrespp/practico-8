#include <iostream>
using namespace std;

// Prototipos
void leer(int v[], int n);
void mostrar(int v[], int n);
void invertirMismoVector(int v[], int n);

int main() {
    int n;
    int v[100];

    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    if (n > 0 && n <= 100) {
        leer(v, n);
        cout << "Vector Antes de invertir: "; mostrar(v, n);

        invertirMismoVector(v, n);

        cout << "Vector Despues de invertir: "; mostrar(v, n);
    } else {
        cout << "Cantidad invalida." << endl;
    }
    return 0;
}

void leer(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Ingrese elemento " << i + 1 << ": ";
        cin >> v[i];
    }
}

void mostrar(int v[], int n) {
    cout << "[ ";
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << "]" << endl;
}

void invertirMismoVector(int v[], int n) {
    int i = 0;
    int j = n - 1;
    while (i < j) {
        int aux = v[i];
        v[i] = v[j];
        v[j] = aux;
        i++;
        j--;
    }
}
