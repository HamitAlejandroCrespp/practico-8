#include <iostream>
using namespace std;

// Prototipos
void leer(int v[], int n);
void mostrar(int v[], int n);
void invertirVector(int A[], int B[], int n);

int main() {
    int n;
    int A[100], B[100];
    
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;
    
    if (n > 0 && n <= 100) {
        leer(A, n);
        invertirVector(A, B, n);
        
        cout << "Vector Original A: ";
        mostrar(A, n);
        cout << "Vector Invertido B: ";
        mostrar(B, n);
    } else {
        cout << "Cantidad invalida." << endl;
    }
    return 0;
}

// Implementaciones
void leer(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Elemento " << i + 1 << ": ";
        cin >> v[i];
    }
}

void mostrar(int v[], int n) {
    cout << "[ ";
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << "]" << endl;
}

void invertirVector(int A[], int B[], int n) {
    int j = 0; // indice para el vector B
    for (int i = n - 1; i >= 0; i--) {
        B[j] = A[i];
        j++;
    }
}
