#include <iostream>
using namespace std;

// Prototipos
void leer(float v[], int n);
void mostrar(float v[], int n);
float calcularPromedio(float v[], int n);

int main() {
    int n;
    float v[100];
    
    cout << "Ingrese cantidad de numeros reales (n > 0): ";
    cin >> n;
    
    if (n > 0 && n <= 100) {
        leer(v, n);
        mostrar(v, n);
        cout << "El promedio es: " << calcularPromedio(v, n) << endl;
    } else {
        cout << "Cantidad no valida." << endl;
    }
    return 0;
}

// Implementaciones
void leer(float v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Valor " << i + 1 << ": ";
        cin >> v[i];
    }
}

void mostrar(float v[], int n) {
    cout << "Elementos: ";
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

float calcularPromedio(float v[], int n) {
    float suma = 0;
    for (int i = 0; i < n; i++) {
        suma = suma + v[i];
    }
    return suma / n;
}
